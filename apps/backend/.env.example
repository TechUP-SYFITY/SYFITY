# 서버 포트
PORT=4000

# FE 클라이언트 주소
CLIENT_URL=http://localhost:3000

# CORS 허용 origin (쉼표 구분)
ALLOWED_ORIGINS=http://localhost:3000

# Vercel Preview origin 허용 정규식 (선택). 특정 프로젝트/팀 URL만 허용한다.
VERCEL_PREVIEW_ORIGIN_PATTERN=

# JWT 시크릿 키
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Supabase 데이터베이스 URL
# 로컬: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# 운영: Supabase 클라우드 Session Pooler Connection String 권장
# - Direct Connection은 IPv6 전용일 수 있어 Render에서 연결 실패 가능
# - Transaction Pooler는 prepared statement 제약이 있어 Prisma 런타임에는 사용하지 않음
DATABASE_URL=

# YouTube Data API v3 키
YOUTUBE_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
