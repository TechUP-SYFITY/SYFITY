generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoomVisibility {
  private
  public
}

enum RoomStatus {
  active
  inactive
  closed
}

enum RoomRole {
  host
  member
  guest
}

enum RoomMemberStatus {
  online
  offline
  left
  kicked
}

enum PlaylistItemStatus {
  available
  unavailable
}

enum ChatMessageType {
  user
  system
}

enum ProfileImageObjectStatus {
  pending
  current
  delete_pending
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  nickname     String
  profileImage String?  @map("profile_image")
  refreshToken String?  @map("refresh_token")
  onboardedAt   DateTime? @map("onboarded_at") @db.Timestamptz
  deletionPendingAt DateTime? @map("deletion_pending_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  hostedRooms   Room[]         @relation("HostedRooms")
  roomMembers   RoomMember[]
  recentRooms   RecentRoom[]
  playlistItems PlaylistItem[]
  chatMessages  ChatMessage[]
  personalPlaylists PersonalPlaylist[]
  profileImageObjects ProfileImageObject[]

  @@map("users")
}

model ProfileImageObject {
  id        String                   @id @default(uuid()) @db.Uuid
  userId    String                   @map("user_id") @db.Uuid
  path      String                   @unique
  status    ProfileImageObjectStatus @default(pending)
  createdAt DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("profile_image_objects")
}

model Room {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  hostId         String         @map("host_id") @db.Uuid
  visibility     RoomVisibility
  inviteCode     String         @unique @map("invite_code") @db.VarChar(8)
  status         RoomStatus     @default(active)
  closedAt       DateTime?      @map("closed_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  host          User           @relation("HostedRooms", fields: [hostId], references: [id])
  roomMembers   RoomMember[]
  recentRooms   RecentRoom[]
  playlistItems PlaylistItem[]
  chatMessages  ChatMessage[]

  @@index([hostId, status, updatedAt(sort: Desc)])
  @@index([closedAt])
  @@map("rooms")
}

model RoomMember {
  id         String           @id @default(uuid()) @db.Uuid
  roomId     String           @map("room_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  role       RoomRole
  status     RoomMemberStatus
  joinedAt   DateTime         @map("joined_at") @db.Timestamptz
  lastSeenAt DateTime?        @map("last_seen_at") @db.Timestamptz
  leftAt     DateTime?        @map("left_at") @db.Timestamptz
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@index([roomId, status])
  @@map("room_members")
}

model RecentRoom {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  roomId       String   @map("room_id") @db.Uuid
  lastJoinedAt DateTime @map("last_joined_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  @@unique([userId, roomId])
  @@index([userId, lastJoinedAt(sort: Desc)])
  @@map("recent_rooms")
}

model PlaylistItem {
  id           String             @id @default(uuid()) @db.Uuid
  roomId       String             @map("room_id") @db.Uuid
  videoId      String             @map("video_id")
  title        String
  channelTitle String             @map("channel_title")
  thumbnailUrl String             @map("thumbnail_url")
  duration     Int
  position     Int
  addedBy      String             @map("added_by") @db.Uuid
  status       PlaylistItemStatus @default(available)
  addedAt      DateTime           @map("added_at") @db.Timestamptz
  metadataRefreshedAt DateTime    @map("metadata_refreshed_at") @db.Timestamptz

  room           Room            @relation(fields: [roomId], references: [id])
  addedByUser    User            @relation(fields: [addedBy], references: [id])

  @@unique([roomId, videoId])
  @@index([roomId, position])
  @@map("playlist_items")
}

model ChatMessage {
  id        String          @id @default(uuid()) @db.Uuid
  roomId    String          @map("room_id") @db.Uuid
  userId    String?         @map("user_id") @db.Uuid
  type      ChatMessageType
  message   String          @db.Text
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz

  room Room  @relation(fields: [roomId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([roomId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("chat_messages")
}

model PersonalPlaylist {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  owner User                   @relation(fields: [ownerId], references: [id])
  items PersonalPlaylistItem[]

  @@index([ownerId, updatedAt(sort: Desc)])
  @@map("personal_playlists")
}

model PersonalPlaylistItem {
  id                 String             @id @default(uuid()) @db.Uuid
  personalPlaylistId String             @map("personal_playlist_id") @db.Uuid
  videoId            String             @map("video_id")
  title              String
  channelTitle       String             @map("channel_title")
  thumbnailUrl       String             @map("thumbnail_url")
  duration           Int
  position           Int
  status             PlaylistItemStatus @default(available)
  addedAt            DateTime           @default(now()) @map("added_at") @db.Timestamptz
  metadataRefreshedAt DateTime           @map("metadata_refreshed_at") @db.Timestamptz

  playlist PersonalPlaylist @relation(fields: [personalPlaylistId], references: [id], onDelete: Cascade)

  @@unique([personalPlaylistId, videoId])
  @@index([personalPlaylistId, position])
  @@map("personal_playlist_items")
}
