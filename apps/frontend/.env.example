# API 서버 주소
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Socket 서버 주소
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# API mocking (enabled | disabled)
NEXT_PUBLIC_API_MOCKING=disabled

# 사이트 기본 URL (OG 메타태그 metadataBase에 사용)
NEXT_PUBLIC_SITE_URL=https://syfity.site

# Supabase Storage 브라우저용 공개 키(service_role 키는 절대 여기에 넣지 않는다)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
