# E2E 로컬 전용 DB 접속값의 단일 출처. 운영과 무관한 더미이므로 커밋한다.
# 소비자 3곳: docker-compose.e2e.yml(env_file)·env.ts(process.loadEnvFile)·root package.json(e2e:db:up/migrate).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=syfity_e2e
E2E_DB_PORT=55432
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/syfity_e2e
